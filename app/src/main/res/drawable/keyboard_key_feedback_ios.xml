<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only
    iOS 27 key preview: a separate rounded tile floating just above the pressed key (no stem).
    KeyPreviewChoreographer sizes and places it; white, tinted by Colors (KEY_PREVIEW_BACKGROUND).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="12dp" />
    <!-- intrinsic size: KeyPreviewView derives its max text width from it -->
    <size android:width="56dp" android:height="70dp" />
</shape>
